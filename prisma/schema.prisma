// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  username    String   @unique
  role        Role     @default(USER)
  // Perfil público
  displayName String?
  bio         String?
  avatarUrl   String?
  coverUrl    String?
  location    String?
  website     String?
  // Relaciones
  posts       Post[]
  likes       Like[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Follows
  followers   Follow[] @relation("user_followed")   // Usuarios que me siguen a mí
  following   Follow[] @relation("user_follows")    // Usuarios a los que sigo
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  likes     Like[]
  comments  Comment[]  // ← Relación inversa: comentarios del post
  images    PostImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id        String   @id @default(uuid())
  
  // Quién dio el like
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  // A qué post
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  
  createdAt DateTime @default(now())
 
  // Un usuario solo puede dar like una vez a un post
  @@unique([userId, postId])
  // Índice para buscar rápido likes de un post
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  
  // Autor
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  
  // Post
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  
  // Jerarquía: comentario padre (null si es comentario raíz)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId  String?
  
  // Respuestas anidadas
  replies   Comment[] @relation("CommentReplies")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  // Índices para queries eficientes
  @@index([postId])
  @@index([parentId])
  @@index([authorId])
}
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("user_follows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("user_followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Destinatario
  type        String   // 'COMMENT_ON_POST', 'REPLY_ON_COMMENT', 'LIKE_ON_POST'
  title       String
  message     String
  read        Boolean  @default(false)
  actorId     String   // Quién generó la notificación
  postId      String?
  commentId   String?
  createdAt   DateTime @default(now())
  
  @@index([userId, read])
  @@index([createdAt])
}

model PostImage {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  key       String   @unique  // posts/{postId}/{uuid}.webp
  url       String
  width     Int
  height    Int
  size      Int
  mimeType  String   @default("image/webp")
  order     Int      @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([postId, order])
  @@index([deletedAt])
}

enum Role {
  USER
  ADMIN
}
